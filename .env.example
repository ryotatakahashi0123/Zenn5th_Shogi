# ローカル開発用。コピーして .env にし、`set -a; . ./.env; set +a` で読み込む。
# 何も設定しなくても動く(MemoryStore + FakeBrain、demo@example.com / demo-pass)。
APP_ENV=dev
STORE=memory          # memory | gcs | firestore
# GCS_BUCKET=                       # STORE=gcs のとき必須
BRAIN=fake            # fake | gemini | none
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-northeast1
# GEMINI_MODEL=gemini-3.5-flash   # 候補。提供状況は未確認。公式で確認して決める
# MY_PLAYER_IDS=                    # 自分の対局者ID(カンマ区切り)。実IDはコミットしない
# 本番(Cloud Run)では次の3つが必須。Secret Manager から渡す
# SESSION_SECRET=
# DEMO_EMAIL=
# DEMO_PASSWORD=
